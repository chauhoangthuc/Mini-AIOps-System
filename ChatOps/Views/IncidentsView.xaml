<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:ChatOps.ViewModel" xmlns:views="clr-namespace:ChatOps.Views" xmlns:charts="clr-namespace:ChatOps.Controls" x:Class="ChatOps.Views.IncidentsView">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel Grid.Row="0">
      <TextBox Width="220" Margin="4" Style="{StaticResource InputBox}" ToolTip="Tìm theo mã, tên PC hoặc IP" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding Search}"/>
        </TextBox.InputBindings>
      </TextBox>
      <ComboBox Margin="4" MinWidth="116" ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}"/>
      <ComboBox Margin="4" MinWidth="116" ItemsSource="{Binding States}" SelectedItem="{Binding State}"/>
      <CheckBox Foreground="{StaticResource TextPrimary}" Margin="4" Content="Còn mở" IsChecked="{Binding OpenOnly}"/>
      <Button Margin="3" Content="Tìm" Style="{StaticResource SecondaryButton}" Command="{Binding Search}"/>
    </WrapPanel>
    <DataGrid AutomationProperties.Name="Danh sách" Style="{StaticResource SocTable}" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" AutoGenerateColumns="False" MinHeight="100" ItemsSource="{Binding Items}" Grid.Row="1" Margin="0,8">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Mã sự cố" Width="Auto" Binding="{Binding IncidentId, TargetNullValue=—}"/>
        <DataGridTextColumn Header="PC" Width="*" Binding="{Binding PcName, TargetNullValue=—}"/>
        <DataGridTextColumn Header="IP" Width="Auto" Binding="{Binding Ip, TargetNullValue=—}"/>
        <DataGridTemplateColumn Header="Mức độ">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <charts:StatusBadge Label="{Binding Severity}"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Trạng thái">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <charts:StatusBadge Label="{Binding WorkflowState}"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="CPU" Width="Auto" Binding="{Binding CpuPct, TargetNullValue=—, StringFormat={}{0:0.#}%}"/>
        <DataGridTextColumn Header="RAM" Width="Auto" Binding="{Binding RamPct, TargetNullValue=—, StringFormat={}{0:0.#}%}"/>
        <DataGridTemplateColumn Header="Thao tác">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Margin="2" Style="{StaticResource SecondaryButton}" Content="✓" Command="{Binding DataContext.ReviewApprove, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Thao tác">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Margin="2" Style="{StaticResource SecondaryButton}" Content="×" Command="{Binding DataContext.ReviewReject, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Thao tác">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Margin="2" Style="{StaticResource SecondaryButton}" Content="Chi tiết" Command="{Binding DataContext.Open, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <WrapPanel Grid.Row="2">
      <Button Margin="3" Content="‹ Trước" Style="{StaticResource SecondaryButton}" Command="{Binding Previous}"/>
      <TextBlock Margin="0,3" TextWrapping="Wrap" Text="{Binding Number, TargetNullValue=—}"/>
      <Button Margin="3" Content="Sau ›" Style="{StaticResource SecondaryButton}" Command="{Binding Next}"/>
    </WrapPanel>
  </Grid>
</UserControl>
