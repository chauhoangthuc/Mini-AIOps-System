<UserControl x:Class="ChatOps.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ChatOps.Model"    
             xmlns:views="clr-namespace:ChatOps.Views"
             x:Name="Sidebar"
             Width="184"
             FontFamily="{StaticResource AppFont}"   
             FontSize="14"
             UseLayoutRounding="True">

    <UserControl.Resources>

        <!-- Viền xanh xuất hiện khi điều hướng bằng bàn phím. -->
        <Style x:Key="NavFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Diện tích bấm và màu nền của từng mục. -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource NavFocusStyle}"/>
            <Setter Property="ToolTip" Value="{Binding Title}"/>
            <Setter Property="AutomationProperties.Name"
                    Value="{Binding Title}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="{StaticResource HoverBackground}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="{StaticResource SelectedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon nét mảnh cho năm mục, vẽ trực tiếp bằng WPF Path. -->
        <Style x:Key="NavIconStyle" TargetType="Path">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{StaticResource TextPrimary}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding Id}"
                             Value="{x:Static models:SectionId.Overview}">
                    <Setter Property="Data"
                            Value="M2,11 L12,2 22,11 M5,9 V22 H10 V15 H14 V22 H19 V9"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Id}"
                             Value="{x:Static models:SectionId.Devices}">
                    <Setter Property="Data"
                            Value="M2,3 H22 V17 H2 Z M12,17 V21 M7,21 H17"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Id}"
                             Value="{x:Static models:SectionId.Incidents}">
                    <Setter Property="Data"
                            Value="M12,2 L23,22 H1 Z M12,9 V14 M12,17 V18"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Id}"
                             Value="{x:Static models:SectionId.Replay}">
                    <Setter Property="Data"
                            Value="M2,4 V9 H7 M2.5,9 A9.5,9.5 0 1 1 2.5,16 M12,7 V12 L16,15"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Id}"
                             Value="{x:Static models:SectionId.Reports}">
                    <Setter Property="Data"
                            Value="M2,22 H22 M4,22 V14 H7 V22 M10,22 V9 H13 V22 M16,22 V3 H19 V22"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Border Background="{StaticResource SidebarBackground}"
            BorderBrush="{StaticResource BorderBrushSubtle}"
            BorderThickness="0,0,1,0">

        <ListBox ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                 SelectionMode="Single"
                 ItemContainerStyle="{StaticResource NavItemStyle}"
                 AutomationProperties.Name="Điều hướng chính"
                 KeyboardNavigation.TabNavigation="Once"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Margin="6,16,6,8"
                 Padding="0"
                 BorderThickness="0"
                 Background="Transparent">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Style="{StaticResource NavIconStyle}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsCompact,
                                                RelativeSource={RelativeSource AncestorType={x:Type views:SidebarView}}}"
                                            Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>
    </Border>
</UserControl>
