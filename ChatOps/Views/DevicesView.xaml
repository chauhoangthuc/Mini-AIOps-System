<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:ChatOps.ViewModel" xmlns:views="clr-namespace:ChatOps.Views" xmlns:charts="clr-namespace:ChatOps.Controls" x:Class="ChatOps.Views.DevicesView">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel Grid.Row="0" HorizontalAlignment="Right">
      <TextBlock Margin="0,3" TextWrapping="Wrap" Text="Tên PC / IP"/>
      <TextBox Width="220" Margin="4" Style="{StaticResource InputBox}" ToolTip="Tìm theo mã, tên PC hoặc IP" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding Search}"/>
        </TextBox.InputBindings>
      </TextBox>
      <Button Margin="3" Content="Tìm" Style="{StaticResource PrimaryButton}" Command="{Binding Search}"/>
      <CheckBox Margin="8" Foreground="{StaticResource TextPrimary}" Content="Chỉ online" IsChecked="{Binding OnlineOnly}"/>
    </WrapPanel>
    <DataGrid AutomationProperties.Name="Danh sách" Style="{StaticResource SocTable}" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" AutoGenerateColumns="False" MinHeight="100" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Grid.Row="1" Margin="0,8">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Tên PC" Width="*" Binding="{Binding PcName, TargetNullValue=—}"/>
        <DataGridTextColumn Header="IP" Width="Auto" Binding="{Binding Ip, TargetNullValue=—}"/>
        <DataGridTemplateColumn Header="Trạng thái">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <charts:StatusBadge Label="{Binding Connection}"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="CPU" Width="Auto" Binding="{Binding CpuPct, TargetNullValue=—, StringFormat={}{0:0.#}%}"/>
        <DataGridTextColumn Header="RAM" Width="Auto" Binding="{Binding RamPct, TargetNullValue=—, StringFormat={}{0:0.#}%}"/>
        <DataGridTextColumn Header="Sự cố" Width="Auto" Binding="{Binding IncidentId, TargetNullValue=—}"/>
        <DataGridTextColumn Header="Lần đo" Width="Auto" Binding="{Binding SampledAt, TargetNullValue=—}"/>
        <DataGridTextColumn Header="" Width="Auto" Binding="{Binding Freshness, TargetNullValue=—}"/>
        <DataGridTemplateColumn Header="Thao tác">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Margin="2" Style="{StaticResource SecondaryButton}" Content="Chi tiết" Command="{Binding DataContext.Open, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ContentControl HorizontalContentAlignment="Stretch" Grid.Column="0">
        <WrapPanel>
          <Button Margin="3" Content="‹ Trước" Style="{StaticResource SecondaryButton}" Command="{Binding Previous}"/>
          <TextBlock Margin="0,3" TextWrapping="Wrap" Text="{Binding Number, TargetNullValue=—}"/>
          <Button Margin="3" Content="Sau ›" Style="{StaticResource SecondaryButton}" Command="{Binding Next}"/>
        </WrapPanel>
      </ContentControl>
      <ContentControl HorizontalContentAlignment="Stretch" Grid.Column="1">
        <WrapPanel HorizontalAlignment="Right">
          <Button Margin="3" Content="Thêm" Style="{StaticResource PrimaryButton}" Command="{Binding Edit}"/>
          <Button Margin="3" Content="Sửa" Style="{StaticResource SecondaryButton}" Command="{Binding EditSelected}"/>
          <Button Margin="3" Content="Xóa" Style="{StaticResource DangerButton}" Command="{Binding Remove}" CommandParameter="{Binding Selected}"/>
        </WrapPanel>
      </ContentControl>
    </Grid>
  </Grid>
</UserControl>
