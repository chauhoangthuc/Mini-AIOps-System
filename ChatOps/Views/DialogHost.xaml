<Window x:Class="ChatOps.Views.DialogHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource AppBackground}" Foreground="{StaticResource TextPrimary}"
    FontFamily="{StaticResource AppFont}" FontSize="14">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Tải lại" DockPanel.Dock="Right" Command="{Binding Refresh}" Style="{StaticResource SecondaryButton}" x:Name="Reload"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{StaticResource WarningForeground}"/>
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" IsCancel="True" Content="Đóng" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch"/>
        </ScrollViewer>
    </DockPanel>
</Window>
