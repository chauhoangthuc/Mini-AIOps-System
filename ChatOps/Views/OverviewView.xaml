<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:ChatOps.ViewModel" xmlns:views="clr-namespace:ChatOps.Views" xmlns:charts="clr-namespace:ChatOps.Controls" x:Class="ChatOps.Views.OverviewView">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ContentControl HorizontalContentAlignment="Stretch" Grid.Column="0">
        <Button Margin="0,0,10,12" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButton}" Command="{Binding Filter}" CommandParameter="open">
          <StackPanel>
            <TextBlock Margin="0,3" TextWrapping="Wrap" Text="{Binding Data.OpenCount}" Style="{StaticResource PageTitle}"/>
            <TextBlock Margin="0,3" TextWrapping="Wrap" Text="Sự cố mở" Style="{StaticResource SecondaryText}"/>
          </StackPanel>
        </Button>
      </ContentControl>
      <ContentControl HorizontalContentAlignment="Stretch" Grid.Column="1">
        <Button Margin="0,0,10,12" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButton}" Command="{Binding Filter}" CommandParameter="pending">
          <StackPanel>
            <TextBlock Margin="0,3" TextWrapping="Wrap" Text="{Binding Data.PendingRequestCount}" Style="{StaticResource PageTitle}"/>
            <TextBlock Margin="0,3" TextWrapping="Wrap" Text="Yêu cầu chờ duyệt" Style="{StaticResource SecondaryText}"/>
          </StackPanel>
        </Button>
      </ContentControl>
      <ContentControl HorizontalContentAlignment="Stretch" Grid.Column="2">
        <Button Margin="0,0,10,12" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButton}" Command="{Binding Filter}" CommandParameter="online">
          <StackPanel>
            <TextBlock Margin="0,3" Style="{StaticResource PageTitle}"><Run Text="{Binding Data.OnlineCount,Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding Data.DeviceCount,Mode=OneWay}"/></TextBlock>
            <TextBlock Margin="0,3" TextWrapping="Wrap" Text="Thiết bị online" Style="{StaticResource SecondaryText}"/>
          </StackPanel>
        </Button>
      </ContentControl>
    </Grid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ContentControl HorizontalContentAlignment="Stretch" Grid.Column="0">
        <Border Style="{StaticResource Card}" Margin="0,0,10,12">
          <StackPanel>
            <TextBlock Margin="0,3" TextWrapping="Wrap" Text="Trạng thái sự cố" Style="{StaticResource SectionTitle}"/>
            <Grid Height="120">
              <charts:StatusRing Open="{Binding Data.OpenCount}" Pending="{Binding Data.PendingIncidentCount}"/>
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Data.OpenCount}" Style="{StaticResource PageTitle}"/>
            </Grid>
            <TextBlock Margin="0,3" TextWrapping="Wrap" Text="Vàng · chờ duyệt     Đỏ · các sự cố mở còn lại" Style="{StaticResource SecondaryText}"/>
          </StackPanel>
        </Border>
      </ContentControl>
      <ContentControl HorizontalContentAlignment="Stretch" Grid.Column="1">
        <Border Style="{StaticResource Card}" Margin="0,0,10,12">
          <StackPanel>
            <TextBlock Margin="0,3" TextWrapping="Wrap" Text="Số sự cố theo thời gian · 24 giờ" Style="{StaticResource SectionTitle}"/>
            <charts:TrendPlot Samples="{Binding Data.Trend}" Height="120" Percent="False"/>
          </StackPanel>
        </Border>
      </ContentControl>
    </Grid>
    <Border Style="{StaticResource Card}" Margin="0,0,10,12">
      <StackPanel>
        <TextBlock Margin="0,3" TextWrapping="Wrap" Text="Hàng đợi sự cố" Style="{StaticResource SectionTitle}"/>
        <DataGrid AutomationProperties.Name="Danh sách" Style="{StaticResource SocTable}" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" AutoGenerateColumns="False" MinHeight="100" MaxHeight="480" ItemsSource="{Binding Data.Queue}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Mã sự cố" Width="Auto" Binding="{Binding IncidentId, TargetNullValue=—}"/>
            <DataGridTextColumn Header="Tiêu đề" Width="*" Binding="{Binding Title, TargetNullValue=—}"/>
            <DataGridTextColumn Header="Thiết bị" Width="*" Binding="{Binding PcName, TargetNullValue=—}"/>
            <DataGridTemplateColumn Header="Mức độ">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <charts:StatusBadge Label="{Binding Severity}"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Trạng thái">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <charts:StatusBadge Label="{Binding WorkflowState}"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Phát hiện" Width="Auto" Binding="{Binding DetectedAt, TargetNullValue=—}"/>
            <DataGridTemplateColumn Header="Thao tác">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Margin="2" Style="{StaticResource SecondaryButton}" Content="Chi tiết" Command="{Binding DataContext.Open, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
  </StackPanel>
</ScrollViewer></UserControl>
