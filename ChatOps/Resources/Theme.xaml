<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Màu nền và chữ -->
    <SolidColorBrush x:Key="AppBackground" Color="#131217"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#101014"/>
    <SolidColorBrush x:Key="SurfaceBackground" Color="#18181C"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#202025"/>
    <SolidColorBrush x:Key="SelectedBackground" Color="#232328"/>
    <SolidColorBrush x:Key="BorderBrushSubtle" Color="#393940"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#F1F0F2"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#BAB8BF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#36EDAD"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#101014"/>

    <!-- Badge: alpha 0x24 tương đương khoảng 14%, chỉ áp dụng cho nền -->
    <SolidColorBrush x:Key="SuccessBackground" Color="#2434CD91"/>
    <SolidColorBrush x:Key="SuccessForeground" Color="#76E7B1"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#24F3B841"/>
    <SolidColorBrush x:Key="WarningForeground" Color="#FFD178"/>
    <SolidColorBrush x:Key="DangerBackground" Color="#24F05264"/>
    <SolidColorBrush x:Key="DangerForeground" Color="#FF909B"/>
    <SolidColorBrush x:Key="NeutralBackground" Color="#249998A0"/>
    <SolidColorBrush x:Key="NeutralForeground" Color="#C5C3CB"/>

    <FontFamily x:Key="AppFont">Inter, Segoe UI</FontFamily>

    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlRadius">5</CornerRadius>

    <!-- Chữ và khối nội dung -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
    </Style>

    <!-- Nút: dùng chung template để giữ màu khi hover, bấm hoặc Tab -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SelectedBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlRadius}">
                        <Grid>
                            <Border x:Name="Overlay"
                                    CornerRadius="{StaticResource ControlRadius}"
                                    IsHitTestVisible="False"/>
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                            <Border x:Name="FocusRing" Margin="1"
                                    CornerRadius="{StaticResource ControlRadius}"
                                    BorderBrush="{TemplateBinding Foreground}"
                                    BorderThickness="1"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="#12FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="#30000000"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button"
           BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button"
           BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="{StaticResource DangerBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource DangerForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerForeground}"/>
    </Style>

    <!-- Ô tìm kiếm / nhập văn bản. Giữ template gốc để hỗ trợ cuộn và chọn chữ. -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SidebarBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Badge: TextBlock con kế thừa màu chữ từ Border -->
    <Style x:Key="NeutralBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource NeutralBackground}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource NeutralForeground}"/>
    </Style>

    <Style x:Key="SuccessBadge" TargetType="Border" BasedOn="{StaticResource NeutralBadge}">
        <Setter Property="Background" Value="{StaticResource SuccessBackground}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessForeground}"/>
    </Style>

    <Style x:Key="WarningBadge" TargetType="Border" BasedOn="{StaticResource NeutralBadge}">
        <Setter Property="Background" Value="{StaticResource WarningBackground}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource WarningForeground}"/>
    </Style>

    <Style x:Key="DangerBadge" TargetType="Border" BasedOn="{StaticResource NeutralBadge}">
        <Setter Property="Background" Value="{StaticResource DangerBackground}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource DangerForeground}"/>
    </Style>

    <!-- Bảng dùng cho Devices, Incidents và hàng đợi ở Overview -->
    <Style x:Key="TableHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource SurfaceBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="TableRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource AppBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBackground}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectedBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TableCell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SocTable" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource AppBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SelectedBackground}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="ColumnHeaderHeight" Value="36"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource TableHeader}"/>
        <Setter Property="RowStyle" Value="{StaticResource TableRow}"/>
        <Setter Property="CellStyle" Value="{StaticResource TableCell}"/>
    </Style>

</ResourceDictionary>